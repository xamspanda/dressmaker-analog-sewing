<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AnalogSewing</AssemblyName>
    <RootNamespace>AnalogSewing</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The game's own assemblies can't be redistributed, so builds reference an installed copy.
    Set DRESSMAKER_DIR (or pass -p:GameDir=...) to the folder containing Dressmaker.exe;
    otherwise the default Steam locations are tried. BepInEx must be installed there.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(DRESSMAKER_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps/common/Dressmaker/Dressmaker.exe')">$(HOME)/.local/share/Steam/steamapps/common/Dressmaker</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\Dressmaker\Dressmaker.exe')">C:\Program Files (x86)\Steam\steamapps\common\Dressmaker</GameDir>
    <Managed>$(GameDir)/Dressmaker_Data/Managed</Managed>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Managed)/Assembly-CSharp.dll')" Text="Dressmaker not found. Set DRESSMAKER_DIR to the folder containing Dressmaker.exe (currently '$(GameDir)')." />
    <Error Condition="!Exists('$(BepInExCore)/BepInEx.dll')" Text="BepInEx 5 is not installed in '$(GameDir)'. Run scripts/install-dev.sh or install BepInEx first." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Framework" HintPath="$(Managed)/Framework.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Managed)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(Managed)/netstandard.dll" Private="false" />
  </ItemGroup>

</Project>
